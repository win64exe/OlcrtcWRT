#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

PROG_OLCRTC=/etc/olcrtcwrt/olcrtcwrt-client.sh
PROG_WDTT=/etc/olcrtcwrt/wdtt-client.sh
NFT_SETUP=/etc/olcrtcwrt/nft-setup.sh
DNS_SETUP=/etc/olcrtcwrt/dns-setup.sh
SINGBOX_SETUP=/etc/olcrtcwrt/singbox-setup.sh
if [ -x /usr/bin/sing-box ]; then
	SINGBOX=/usr/bin/sing-box
elif [ -x /usr/sbin/sing-box ]; then
	SINGBOX=/usr/sbin/sing-box
else
	SINGBOX=/usr/bin/sing-box
fi

start_node() {
	local cfg="$1"
	local node_type node_enabled
	config_get node_type "$cfg" type
	config_get_bool node_enabled "$cfg" enabled 0

	[ "$node_enabled" -eq 1 ] || return 0

	case "$node_type" in
		olcrtcwrt)
			procd_open_instance "olcrtcwrt_$cfg"
			procd_set_param command "$PROG_OLCRTC" start --foreground "$cfg"
			procd_set_param respawn
			procd_set_param stdout 1
			procd_set_param stderr 1
			procd_close_instance
		;;
		wdtt)
			procd_open_instance "wdtt_$cfg"
			procd_set_param command "$PROG_WDTT" start --foreground "$cfg"
			procd_set_param respawn
			procd_set_param stdout 1
			procd_set_param stderr 1
			procd_close_instance
		;;
	esac
}

start_service() {
	config_load olcrtcwrt

	local enabled autostart
	config_get_bool enabled global enabled 0
	config_get_bool autostart global autostart 0

	[ "$enabled" -eq 1 ] || return 0
	[ "$autostart" -eq 1 ] || return 0

	config_foreach start_node node

	local proxy_enabled routing_core
	config_get_bool proxy_enabled proxy enabled 0
	config_get routing_core proxy routing_core "nftables"

	[ "$proxy_enabled" -eq 1 ] || return 0

	if [ "$routing_core" = "sing-box" ]; then
		[ -x "$SINGBOX_SETUP" ] && "$SINGBOX_SETUP" setup
		[ -x "$SINGBOX" ] || { logger -t olcrtcwrt "sing-box binary not found at $SINGBOX"; return 1; }
		[ -f "/var/etc/olcrtcwrt/sing-box/config.json" ] || { logger -t olcrtcwrt "sing-box config not generated"; return 1; }
		procd_open_instance "olcrtcwrt_singbox"
		procd_set_param command "$SINGBOX" run -c "/var/etc/olcrtcwrt/sing-box/config.json"
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	else
		[ -x "$NFT_SETUP" ] && "$NFT_SETUP" setup
		[ -x "$DNS_SETUP" ] && "$DNS_SETUP" setup
	fi
}

stop_service() {
	[ -x "$NFT_SETUP" ] && "$NFT_SETUP" teardown
	[ -x "$DNS_SETUP" ] && "$DNS_SETUP" clear
	[ -x "$SINGBOX_SETUP" ] && "$SINGBOX_SETUP" clear
}

service_triggers() {
	procd_add_reload_trigger "olcrtcwrt"
}

reload_service() {
	stop
	start
}
