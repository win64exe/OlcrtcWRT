config global 'global'
	option enabled '0'
	option log_level 'info'
	option stats_interval '5'
	option ping_interval '10'
	option autostart '0'

config node 'olcrtcwrt_main'
	option enabled '0'
	option type 'olcrtcwrt'
	option mode 'client'
	option connection_uri ''
	option server_uri ''
	option shared_key ''
	option provider 'jitsi'
	option transport 'datachannel'
	option local_socks_host '127.0.0.1'
	option local_socks_port '1080'
	option extra_args ''
	option dialer_proxy ''

config node 'wdtt_main'
	option enabled '0'
	option type 'wdtt'
	option vps_host ''
	option vps_port '56000'
	option vk_hash ''
	option password ''
	option threads '4'
	option local_udp_port '9000'
	option wireguard_config '/etc/olcrtcwrt/wdtt.conf'
	option wireguard_iface ''
	option auto_captcha '1'
	option dialer_proxy ''

config proxy 'proxy'
	option enabled '0'
	option routing_core 'nftables'
	option http_host '0.0.0.0'
	option http_port '8080'
	option socks_host '0.0.0.0'
	option socks_port '1080'
	option redirect_to_olcrtcwrt '1'
	option mode 'disabled'
	option bypass_local '1'
	list bypass_ips '192.168.0.0/16'
	list bypass_ips '10.0.0.0/8'
	list bypass_ips '172.16.0.0/12'
	list bypass_ips6 'fc00::/7'
	list bypass_ips6 'fe80::/10'
	list bypass_server_domains ''

config subscription 'main'
	option enabled '0'
	option url ''
	option auto_update '0'
	option update_interval '24'

config dns 'dns'
	option enabled '0'
	option proxy_dns '127.0.0.1#5353'
	option fallback_dns '8.8.8.8'
	list direct_domains 'local'
	list direct_domains 'lan'
	list proxy_domains 'youtube.com'
	list proxy_domains 'google.com'
