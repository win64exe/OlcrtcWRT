{
	"luci-app-olcrtc": {
		"description": "Grant access to olcrtc and WDTT management",
		"read": {
			"ubus": {
				"olcrtc": ["status", "nodes", "ping", "traffic", "logs", "nftables", "validate"]
			},
			"uci": ["olcrtc"]
		},
		"write": {
			"ubus": {
				"olcrtc": ["start", "stop", "restart", "download", "update_subscription"]
			},
			"uci": ["olcrtc"],
			"file": {
				"/etc/olcrtc/bin": ["write"],
				"/etc/olcrtc/bin/*": ["write"]
			}
		}
	}
}
